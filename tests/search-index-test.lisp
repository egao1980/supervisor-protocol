(in-package #:supervisor-protocol/tests)

;;; H8c index over standalone logs: keys, incremental refresh, persisted .six
;;; files (written, loaded, rebuilt byte-identical), drops, close, the
;;; embeddings hook.

(defun build-lines () (corpus-lines "build"))

(deftest index-keys-and-logs
  (with-temp-dir (root)
    (let ((index (ss:make-log-index))
          (a (make-corpus-log root "rove"))
          (b (make-corpus-log root "build")))
      (ok (null (ss:index-log-keys index)) "no supervisor, no state directory: empty")
      (ok (equal "rove" (ss:index-add-log index a :key "rove")))
      (ok (equal "build" (ss:index-add-log index b)) "default key: the directory name")
      (ok (equal "build" (ss:index-add-log index b)) "the same directory again is a no-op")
      (ok (equal '("build" "rove") (ss:index-log-keys index)) "other logs sorted by key")
      (ok (signals (ss:index-add-log index b :key "rove") 'ss:search-error)
          "a key already used for another directory")
      (ok (signals (ss:index-add-log index (merge-pathnames "nope/" root)) 'log-not-found))
      (ok (typep (ss:index-unit-log index "rove") 'unit-log))
      (ok (equal "rove" (ss:index-log-key index a)))
      (ok (null (ss:index-unit-log index "nope")))
      (ok (eq t (ss:index-remove-log index "rove")))
      (ok (null (ss:index-remove-log index "rove")))
      (ok (equal '("build") (ss:index-log-keys index)))
      (ss:close-log-index index))))

(deftest index-refresh-is-incremental
  (with-temp-dir (root)
    (let ((lines (build-lines))
          (index (ss:make-log-index)))
      (multiple-value-bind (dir sink) (make-corpus-log root "build" :close nil :lines (subseq lines 0 20))
        (unwind-protect
             (progn
               (ss:index-add-log index dir :key "build")
               (ok (= 20 (ss:refresh-index index)) "the first 20 records")
               (ok (= 0 (ss:refresh-index index)) "nothing new")
               (ok (in-top-p (corpus-ref index "build" 19) index "undeclared" :k 1))
               (ok (null (ss:search-logs index "unused")) "line 46 is not written yet")
               (write-corpus-lines sink "build" (subseq lines 20))
               (ok (= 31 (ss:refresh-index index)) "only the 31 new records")
               (ok (= 51 (stat index :records)))
               (ok (= 51 (stat index :tokenized)) "nothing tokenized twice")
               (ok (in-top-p (corpus-ref index "build" 46) index "unused variable" :k 1)
                   "a line written after the first refresh is found"))
          (sink-close sink)
          (ss:close-log-index index))))))

(deftest index-stack-trace-completed-by-a-later-refresh
  (with-temp-dir (root)
    (let ((lines (corpus-lines "devserver"))
          (index (ss:make-log-index)))
      (multiple-value-bind (dir sink) (make-corpus-log root "devserver" :close nil :lines (subseq lines 0 7))
        (unwind-protect
             (progn
               (ss:index-add-log index dir :key "devserver")
               (ok (null (ss:search-logs index "" :kinds '(:stack-trace)))
                   "the TypeError header alone is no trace")
               (write-corpus-lines sink "devserver" (subseq lines 7 12))
               (let ((hits (ss:search-logs index "" :kinds '(:stack-trace))))
                 (ok (equal (list (corpus-ref index "devserver" 7)) (hit-refs hits))
                     "the header, indexed earlier, now starts the trace")
                 (ok (equal (cons (line-of-fixture index "devserver" 7)
                                  (line-of-fixture index "devserver" 12))
                            (ss:hit-extent (first hits))))
                 (ok (equal '(:error :stack-trace) (ss:hit-kinds (first hits))))))
          (sink-close sink)
          (ss:close-log-index index))))))

(defun small-build-log (root &key (close t))
  "The build fixture in ~1 KiB segments (several of them), all retained."
  (make-corpus-log root "build" :close close :segment-size 1024 :segments 100 :max-record 256))

(deftest index-persists-sealed-segments
  (with-temp-dir (root)
    (let* ((dir (small-build-log root))
           (n (length (log-segments dir))))
      (ok (> n 2) "several segments")
      (let ((index (ss:make-log-index)))
        (ss:index-add-log index dir :key "build")
        (ok (= 51 (ss:refresh-index index)))
        (ok (= n (length (six-files dir))) "one .six per segment of a closed log")
        (ok (= n (stat index :written)))
        (let ((refs (top-refs index "cc parser" :k 5)))
          (ss:close-log-index index)
          (let ((again (ss:make-log-index)))
            (ss:index-add-log again dir :key "build")
            (ok (= 0 (ss:refresh-index again)) "a fresh index loads, it does not tokenize")
            (ok (= n (stat again :loaded)))
            (ok (= 0 (stat again :tokenized)))
            (ok (equal refs (top-refs again "cc parser" :k 5)) "same results from the files")
            (ss:close-log-index again)))))))

(deftest index-rebuilds-missing-or-corrupt-six
  (with-temp-dir (root)
    (let* ((dir (small-build-log root))
           (index (ss:make-log-index)))
      (ss:index-add-log index dir :key "build")
      (ss:refresh-index index)
      (ss:close-log-index index)
      (let* ((files (six-files dir))
             (n (length files))
             (originals (mapcar #'read-file-octets files))
             (records-1 (log-segment-records (first (log-segments dir))))
             (records-2 (log-segment-records (second (log-segments dir)))))
        (delete-file (first files))
        (let ((v (copy-seq (second originals))))
          (setf (aref v (floor (length v) 2)) (logxor #xFF (aref v (floor (length v) 2))))
          (write-file-octets (second files) v))
        (let ((again (ss:make-log-index)))
          (ss:index-add-log again dir :key "build")
          ;; Header records are not output records: each segment has one.
          (ok (= (+ records-1 records-2 -2) (ss:refresh-index again))
              "only the two damaged segments are tokenized")
          (ok (= 1 (stat again :rebuilt)) "the corrupt one counts as rebuilt")
          (ok (= (- n 2) (stat again :loaded)))
          (ok (equalp originals (mapcar #'read-file-octets (six-files dir)))
              "rebuilt files are byte-identical")
          (ss:close-log-index again))))))

(deftest index-open-log-keeps-newest-segment-in-memory
  (with-temp-dir (root)
    (multiple-value-bind (dir sink) (small-build-log root :close nil)
      (let ((index (ss:make-log-index))
            (n (length (log-segments dir))))
        (unwind-protect
             (progn
               (ss:index-add-log index dir :key "build")
               (ss:refresh-index index)
               (ok (= (1- n) (length (six-files dir))) "the newest segment of an open log has no .six")
               (ok (null (probe-file (six-path dir n))))
               (sink-close sink)
               (ss:refresh-index index)
               (ok (probe-file (six-path dir n)) "written once the log is closed"))
          (ignore-errors (sink-close sink))
          (ss:close-log-index index))))))

(deftest index-persist-nil-writes-nothing
  (with-temp-dir (root)
    (let ((dir (small-build-log root))
          (index (ss:make-log-index :persist nil)))
      (ss:index-add-log index dir :key "build")
      (ok (= 51 (ss:refresh-index index)))
      (ok (null (six-files dir)))
      (ok (= 0 (stat index :written)))
      (ss:close-log-index index))))

(defun word-lines (from to)
  (loop for i from from to to collect (format nil "record word~5,'0D filler text" i)))

(deftest index-drop-forgets-segment-and-its-file
  (with-temp-dir (root)
    (let* ((dir (uiop:ensure-directory-pathname (merge-pathnames "w/" root)))
           (sink (make-log-sink dir :supervisor-id "rec" :unit-id "w" :kind :shell-job
                                    :segment-size 1024 :segments 3 :max-record 256))
           (index (ss:make-log-index)))
      (unwind-protect
           (progn
             (write-lines sink :stdout (word-lines 1 20))
             (ss:index-add-log index dir :key "w")
             (ok (in-top-p (ref-of-text dir "w" "record word00001 filler text") index "word00001")
                 "found before the drop")
             (ok (probe-file (six-path dir 1)) "segment 1 sealed and persisted")
             (write-lines sink :stdout (word-lines 21 200))
             (multiple-value-bind (records gaps) (log-read dir)
               (declare (ignore records))
               (ok gaps "segment 1 was dropped"))
             (ok (null (ss:search-logs index "word00001")) "nothing in a gap is found")
             (ok (null (probe-file (six-path dir 1))) "its .six is gone too")
             (let ((hits (ss:search-logs index "word00200")))
               (ok (= 1 (length hits)))
               (ok (equal (ref-of-text dir "w" "record word00200 filler text") (ss:hit-ref (first hits)))
                   "the ref names the retained segment"))
             (let* ((r (first (log-read dir)))
                    (word (second (uiop:split-string (log-record-text r) :separator " "))))
               (ok (equal (ss:format-log-ref "w" (log-record-segment r) (log-record-line r))
                          (first (top-refs index word :k 1)))
                   "the oldest retained line is searchable")))
        (sink-close sink)
        (ss:close-log-index index)))))

(deftest index-hit-excerpt-reports-gaps
  (with-temp-dir (root)
    (let* ((dir (uiop:ensure-directory-pathname (merge-pathnames "w/" root)))
           (index (ss:make-log-index)))
      (with-log-sink (sink dir :supervisor-id "rec" :unit-id "w" :kind :shell-job
                               :segment-size 1024 :segments 2 :max-record 256)
        (write-lines sink :stdout (word-lines 1 120)))
      (ss:index-add-log index dir :key "w")
      (let* ((r (first (log-read dir)))
             (word (second (uiop:split-string (log-record-text r) :separator " ")))
             (hit (first (ss:search-logs index word :k 1))))
        (ok (and hit (= (log-record-line r) (ss:hit-line hit))) "the oldest retained output line")
        (multiple-value-bind (records gaps) (ss:hit-excerpt index hit :context 3)
          (ok gaps "the excerpt reaches back into the dropped range")
          (ok (every (lambda (r) (eq :output (log-record-type r))) records))
          (ok (member (ss:hit-line hit) (mapcar #'log-record-line records)))))
      (ss:close-log-index index))))

(deftest index-close-is-idempotent
  (let ((index (ss:make-log-index)))
    (ok (null (ss:close-log-index index)))
    (ok (null (ss:close-log-index index)))
    (ok (ss:index-closed-p index))
    (ok (signals (ss:search-logs index "x") 'ss:index-closed))
    (ok (signals (ss:refresh-index index) 'ss:index-closed))))

(deftest index-embedding-hook
  (with-temp-dir (root)
    (let* ((embedder (make-instance 'counting-embedder))
           (index (ss:make-log-index :embedder embedder))
           (lines (word-lines 1 40)))
      (multiple-value-bind (dir sink) (make-corpus-log root "w" :close nil :lines (subseq lines 0 20))
        (unwind-protect
             (progn
               (ss:index-add-log index dir :key "w")
               (ss:refresh-index index)
               ;; Lines 1-16 (header + 15 output lines) are complete; 17-21 are not.
               (ok (equal (list (list (format nil "~{~A~^~%~}" (subseq lines 0 15))))
                          (reverse (embedder-calls embedder)))
                   "block 0 embedded once, its output lines joined by LF")
               (ss:refresh-index index)
               (ok (= 1 (length (embedder-calls embedder))) "not again")
               (ok (typep (ss:index-block-embedding index "w" 0) '(simple-array single-float (*))))
               (ok (null (ss:index-block-embedding index "w" 1)) "block 1 is not complete")
               (write-corpus-lines sink "w" (subseq lines 20))
               (sink-close sink)
               (ss:refresh-index index)
               (ok (equal '(1 2) (mapcar #'length (reverse (embedder-calls embedder))))
                   "one call per refresh: block 1 (complete) and block 2 (its log closed)")
               (ok (equal (format nil "~{~A~^~%~}" (subseq lines 31))
                          (second (first (embedder-calls embedder))))
                   "block 2: output lines 33-41"))
          (ignore-errors (sink-close sink))
          (ss:close-log-index index))))))
