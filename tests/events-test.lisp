(in-package #:supervisor-protocol/tests)

;;; The state-change event stream: ordered, gap-free, replayable.

(defun quick-thread (sup &optional (result t))
  (start-unit sup :subagent :function (lambda (u) (declare (ignore u)) result)))

(deftest events-of-one-unit
  (with-supervisor (sup)
    (let* ((c (make-collector sup))
           (u (start-unit sup :shell-job :command (exit-argv 0)))
           (es (wait-collected c (lambda (es) (= 3 (length es))))))
      (wait-unit u :timeout 20)
      (ok (equal '((:state nil :starting) (:state :starting :running) (:state :running :exited))
                 (transitions es (unit-id u))))
      (ok (equal '(1 2 3) (mapcar #'event-seq es)))
      (ok (every (lambda (e) (string= (unit-id u) (event-unit-id e))) es))
      (ok (every (lambda (e) (eq :shell-job (event-unit-kind e))) es))
      (ok (every (lambda (e) (integerp (event-time e))) es))
      (ok (every (lambda (e) (realp (event-monotonic e))) es))
      (ok (apply #'<= (mapcar #'event-monotonic es)))
      (ok (eql 0 (getf (event-detail (third es)) :exit-code)) "final events carry the exit code")
      (ok (= 3 (supervisor-last-seq sup))))))

(deftest killed-event-detail
  (with-supervisor (sup)
    (let* ((c (make-collector sup))
           (u (start-unit sup :subagent :function (cooperative-body))))
      (stop-unit u)
      (let ((last (car (last (wait-collected c (lambda (es) (= 3 (length es))))))))
        (ok (equal '(:state :running :killed) (list (event-type last) (event-from last) (event-to last))))
        (ok (null (getf (event-detail last) :signal)) "threads get no signal")))))

(deftest events-since-replays
  (with-supervisor (sup)
    (let ((a (quick-thread sup)) (b (quick-thread sup)))
      (wait-unit a :timeout 5) (wait-unit b :timeout 5)
      (ok (wait-until (lambda () (= 6 (supervisor-last-seq sup)))))
      (multiple-value-bind (all complete) (events-since sup 0)
        (ok (equal '(1 2 3 4 5 6) (mapcar #'event-seq all)))
        (ok (eq t complete)))
      (ok (equal '(5 6) (mapcar #'event-seq (events-since sup 4))))
      (ok (equal '() (events-since sup 6)))
      (ok (equal '((:state nil :starting) (:state :starting :running) (:state :running :exited))
                 (transitions (events-since sup 0) (unit-id b)))))))

(deftest subscribe-since-replays-then-continues
  (with-supervisor (sup)
    (wait-unit (quick-thread sup) :timeout 5)
    (ok (wait-until (lambda () (= 3 (supervisor-last-seq sup)))))
    (let ((c (make-collector sup :since 1)))
      (ok (equal '(2 3) (mapcar #'event-seq (wait-collected c (lambda (es) (= 2 (length es)))))))
      (wait-unit (quick-thread sup) :timeout 5)
      (ok (equal '(2 3 4 5 6) (mapcar #'event-seq (wait-collected c (lambda (es) (= 5 (length es)))))))
      (sleep 0.2)
      (ok (= 5 (length (collected c))) "no duplicates"))
    (let ((live (make-collector sup)))
      (wait-unit (quick-thread sup) :timeout 5)
      (ok (equal '(7 8 9) (mapcar #'event-seq (wait-collected live (lambda (es) (= 3 (length es))))))
          "without :since: only new events"))))

(deftest unsubscribe-stops-delivery
  (with-supervisor (sup)
    (let ((c (make-collector sup)))
      (wait-unit (quick-thread sup) :timeout 5)
      (wait-collected c (lambda (es) (= 3 (length es))))
      (ok (subscription-active-p (collector-subscription c)))
      (ok (null (unsubscribe (collector-subscription c))))
      (ok (not (subscription-active-p (collector-subscription c))))
      (ok (null (unsubscribe (collector-subscription c))) "idempotent")
      (wait-unit (quick-thread sup) :timeout 5)
      (sleep 0.3)
      (ok (= 3 (length (collected c)))))))

(deftest failing-subscriber-is-dropped
  (with-supervisor (sup)
    (let* ((bad (subscribe sup (lambda (e) (declare (ignore e)) (error "callback bug"))))
           (good (make-collector sup)))
      (wait-unit (quick-thread sup) :timeout 5)
      (ok (= 3 (length (wait-collected good (lambda (es) (= 3 (length es)))))) "others carry on")
      (ok (wait-until (lambda () (not (subscription-active-p bad)))))
      (ok (typep (subscription-error bad) 'simple-error)))))

(deftest callbacks-run-on-one-thread-in-order
  (with-supervisor (sup)
    (let* ((threads '()) (lock (bt2:make-lock))
           (c (make-collector sup)))
      (subscribe sup (lambda (e) (declare (ignore e))
                       (bt2:with-lock-held (lock) (pushnew (bt2:current-thread) threads))))
      (let ((units (loop repeat 10 collect (quick-thread sup))))
        (dolist (u units) (wait-unit u :timeout 5))
        (let ((es (wait-collected c (lambda (es) (= 30 (length es))))))
          (ok (equal (loop for i from 1 to 30 collect i) (mapcar #'event-seq es)) "no gaps, in order")
          (dolist (u units)
            (ok (equal '((:state nil :starting) (:state :starting :running) (:state :running :exited))
                       (transitions es (unit-id u)))))))
      (ok (= 1 (length threads)) "one dispatcher thread")
      (ok (not (eq (bt2:current-thread) (first threads)))))))

(deftest event-capacity-bounds-replay
  (with-supervisor (sup :event-capacity 4)
    (wait-unit (quick-thread sup) :timeout 5)
    (wait-unit (quick-thread sup) :timeout 5)
    (ok (wait-until (lambda () (= 6 (supervisor-last-seq sup)))))
    (multiple-value-bind (es complete) (events-since sup 0)
      (ok (equal '(3 4 5 6) (mapcar #'event-seq es)) "the newest 4")
      (ok (null complete) "events 1-2 were dropped"))
    (multiple-value-bind (es complete) (events-since sup 2)
      (ok (equal '(3 4 5 6) (mapcar #'event-seq es)))
      (ok (eq t complete)))))

(deftest shutdown-ends-subscriptions
  (let* ((sup (make-supervisor :exit-hook nil))
         (c (make-collector sup)))
    (start-unit sup :subagent :function (cooperative-body))
    (shutdown-supervisor sup)
    (ok (wait-until (lambda () (equal '(:state :running :killed)
                                      (let ((e (car (last (collected c)))))
                                        (and e (list (event-type e) (event-from e) (event-to e)))))))
        "the final events are delivered")
    (ok (not (subscription-active-p (collector-subscription c))))))
