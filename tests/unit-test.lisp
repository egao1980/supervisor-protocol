(in-package #:supervisor-protocol/tests)

;;; Starting units: readers, ids, outcomes, start errors.

(deftest supervisor-basics
  (with-supervisor (sup)
    (ok (typep sup 'supervisor))
    (ok (stringp (supervisor-id sup)))
    (ok (uiop:string-prefix-p (format nil "~D-" (current-pid)) (supervisor-id sup)))
    (ok (= (+ (length (princ-to-string (current-pid))) 9) (length (supervisor-id sup))))
    (ok (null (supervisor-state-directory sup)))
    (ok (null (supervisor-sweep-report sup)))
    (ok (null (supervisor-exit-hook sup)) "with-supervisor passes :exit-hook nil")
    (ok (member sup (live-supervisors)))
    (let ((root (supervisor-root-scope sup)))
      (ok (eq :supervisor (scope-kind root)))
      (ok (null (scope-parent root)))
      (ok (eq sup (scope-supervisor root))))
    (ok (null (supervisor-units sup)))
    (ok (= 0 (supervisor-last-seq sup))))
  (let ((sup (make-supervisor :exit-hook nil)))
    (shutdown-supervisor sup)
    (ok (supervisor-closed-p sup))
    (ok (not (member sup (live-supervisors))))
    (ok (null (shutdown-supervisor sup)) "idempotent")))

(deftest process-unit-readers
  (with-temp-dir (dir)
    (with-supervisor (sup)
      (let* ((argv (sleeper-argv 30))
             (u (start-unit sup :shell-job :command argv :cwd dir
                                           :labels '(:tool "bash" :n 1))))
        (ok (string= "shell-job-1" (unit-id u)))
        (ok (eq :shell-job (unit-kind u)))
        (ok (eq (supervisor-root-scope sup) (unit-owner u)) "default owner: the root")
        (ok (equal '(:tool "bash" :n 1) (unit-labels u)))
        (ok (equal argv (unit-command u)))
        (ok (equal dir (unit-cwd u)))
        (ok (null (unit-function u)))
        (ok (eq :running (unit-state u)))
        (ok (unit-live-p u))
        (ok (not (unit-finished-p u)))
        (ok (typep (unit-pid u) '(integer 1)))
        (ok (pid-alive-p (unit-pid u)))
        (if (windows-p)
            (ok (null (unit-pgid u)))
            (ok (eql (unit-pid u) (unit-pgid u)) "Unix: leads its own process group"))
        (ok (stringp (unit-os-start-time u)))
        (ok (<= (- (get-universal-time) 30) (unit-start-time u) (get-universal-time)))
        (ok (eq :never (unit-restart-policy u)))
        (ok (= +default-max-restarts+ (unit-max-restarts u)))
        (ok (equal +default-backoff+ (unit-backoff u)))
        (ok (= 0 (unit-restart-count u)))
        (ok (null (unit-exit-code u)))
        (ok (null (unit-signal u)))
        (ok (not (unit-interacting-p u)))
        (ok (not (unit-stop-requested-p u)))
        (ok (typep (unit-executor u) 'process-executor))
        (ok (eq sup (unit-supervisor u)))
        (ok (typep (unit-output-sink u) 'head-tail-buffer))
        (ok (eq u (find-unit sup "shell-job-1")))
        (ok (null (find-unit sup "shell-job-2")))
        (ok (equal (list u) (supervisor-units sup)))))))

(deftest ids-count-per-kind
  (with-supervisor (sup)
    (let ((a (start-unit sup :shell-job :command (sleeper-argv 30)))
          (b (start-unit sup :rpc :command (sleeper-argv 30)))
          (c (start-unit sup :shell-job :command (sleeper-argv 30)))
          (d (start-unit sup :subagent :function (cooperative-body))))
      (ok (equal '("shell-job-1" "rpc-1" "shell-job-2" "subagent-1") (ids (list a b c d))))
      (ok (equal (list a b c d) (supervisor-units sup)) "start order"))))

(deftest process-exit-codes
  (with-supervisor (sup)
    (let ((ok0 (start-unit sup :shell-job :command (exit-argv 0)))
          (bad (start-unit sup :shell-job :command (exit-argv 3))))
      (ok (equal '(:exited 0) (multiple-value-list (wait-unit ok0 :timeout 20))))
      (ok (equal '(:failed 3) (multiple-value-list (wait-unit bad :timeout 20))))
      (ok (= 0 (unit-exit-code ok0)))
      (ok (= 3 (unit-exit-code bad)))
      (ok (unit-finished-p ok0))
      (ok (not (unit-live-p bad)))
      (ok (null (unit-signal bad))))))

(deftest process-output-captured
  (with-supervisor (sup)
    (let ((u (start-unit sup :shell-job
                         :command (lisp-argv "(progn (write-line \"to-stdout\") (finish-output) (write-line \"to-stderr\" *error-output*) (finish-output *error-output*))"))))
      (wait-unit u :timeout 20)
      (ok (search "to-stdout" (unit-output u)))
      (ok (search "to-stderr" (unit-output u))))))

(deftest process-cwd-and-env
  (with-temp-dir (dir)
    (with-supervisor (sup)
      (let ((u (start-unit sup :shell-job :cwd dir :env '(("SUPERVISOR_TEST_VAR" . "h8a"))
                           :command (lisp-argv "(progn (write-line (sb-ext:posix-getenv \"SUPERVISOR_TEST_VAR\")) (write-line (namestring *default-pathname-defaults*)) (with-open-file (s \"marker.txt\" :direction :output) (write-line \"x\" s)))"))))
        (wait-unit u :timeout 20)
        (ok (search "h8a" (unit-output u)))
        (ok (probe-file (merge-pathnames "marker.txt" dir)) "ran in CWD")))))

(deftest thread-unit-outcomes
  (with-supervisor (sup)
    (let* ((seen nil)
           (ret (start-unit sup :subagent
                            :function (lambda (u)
                                        (setf seen (list u *current-unit*
                                                         *current-scope* (bt2:current-thread)))
                                        42)))
           (err (start-unit sup :subagent :function (lambda (u) (declare (ignore u))
                                                      (error "subagent crashed")))))
      (ok (equal '(:exited nil) (multiple-value-list (wait-unit ret :timeout 5))))
      (ok (= 42 (unit-result ret)))
      (ok (eq ret (first seen)))
      (ok (eq ret (second seen)) "*current-unit* is the unit")
      (ok (eq (unit-owner ret) (third seen)) "*current-scope* is its owner")
      (ok (not (eq (bt2:current-thread) (fourth seen))) "its own thread")
      (ok (null (unit-pid ret)))
      (ok (null (unit-pgid ret)))
      (ok (null (unit-os-start-time ret)))
      (ok (typep (unit-executor ret) 'thread-executor))
      (ok (eq :failed (wait-unit err :timeout 5)))
      (ok (typep (unit-condition err) 'simple-error))
      (ok (search "subagent crashed" (princ-to-string (unit-condition err)))))))

(deftest thread-unit-writes-its-sink
  (with-supervisor (sup)
    (let ((u (start-unit sup :subagent
                         :function (lambda (u) (sink-write (unit-output-sink u) :stdout "thinking…") t))))
      (wait-unit u :timeout 5)
      (ok (string= "thinking…" (unit-output u))))))

(deftest start-errors
  (with-supervisor (sup)
    (ok (signals (start-unit sup :shell-job :command '("/no/such/program-h8a"))
                 'unit-start-error))
    (ok (null (supervisor-units sup)) "nothing registered")
    (ok (signals (start-unit sup :shell-job) 'unit-start-error) "neither command nor function")
    (ok (signals (start-unit sup :shell-job :command (sleeper-argv 1)
                                            :function (cooperative-body))
                 'unit-start-error)
        "both")
    (ok (signals (start-unit sup :shell-job :executor (make-instance 'failing-executor))
                 'unit-start-error))
    (ok (signals (start-unit sup "not-a-keyword" :function (cooperative-body)) 'type-error))
    (let ((u (start-unit sup :shell-job :command (sleeper-argv 30))))
      (ok (string= "shell-job-1" (unit-id u)) "failed starts consumed no id"))
    (with-supervisor (other)
      (ok (signals (start-unit sup :shell-job :command (sleeper-argv 1)
                                              :owner (supervisor-root-scope other))
                   'supervisor-error)
          "an owner from another supervisor"))))

(deftest start-after-shutdown
  (let ((sup (make-supervisor :exit-hook nil)))
    (shutdown-supervisor sup)
    (ok (signals (start-unit sup :subagent :function (cooperative-body)) 'supervisor-closed))
    (ok (signals (make-scope sup :session "late") 'supervisor-closed))))

(deftest custom-executor
  (with-supervisor (sup)
    (let* ((e (make-instance 'stubborn-executor))
           (u (start-unit sup :pty :executor e)))
      (ok (eq e (unit-executor u)))
      (ok (eq :running (unit-state u)))
      (ok (eq :killed (stop-unit u :grace 0.1 :force-grace 1)))
      (ok (equal '(:graceful :force) (stops-received e))))))

(deftest executor-capabilities
  (let ((p (make-process-executor)) (th (make-thread-executor)))
    (ok (executor-supports-p p :pid))
    (ok (executor-supports-p p :tree))
    (ok (executor-supports-p p :input))
    (ok (eq (not (windows-p)) (and (executor-supports-p p :graceful-stop) t)))
    (ok (not (executor-supports-p th :pid)))
    (ok (not (executor-supports-p th :input)))
    (ok (executor-supports-p th :graceful-stop))
    (ok (not (executor-supports-p p :no-such-capability)))))

(deftest send-input-errors
  (with-supervisor (sup)
    (let ((th (start-unit sup :subagent :function (cooperative-body)))
          (done (start-unit sup :shell-job :command (exit-argv 0))))
      (ok (signals (send-unit-input th "x") 'executor-unsupported))
      (wait-unit done :timeout 20)
      (ok (signals (send-unit-input done "x") 'unit-not-running)))))
