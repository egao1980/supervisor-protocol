(in-package #:supervisor-protocol/tests)

;;; H8b standalone log sinks (no supervisor): records, continuation, long lines,
;;; binary, rotation caps, drop markers, the head + tail view.

(deftest log-sink-construction
  (with-temp-dir (dir)
    (let ((d (merge-pathnames "a/b/" dir)))
      (with-log-sink (s d :segment-size 4096 :segments 3 :max-record 256)
        (ok (typep s 'log-sink))
        (ok (typep s 'head-tail-buffer))
        (ok (= 4096 (log-sink-segment-size s)))
        (ok (= 3 (log-sink-segments s)))
        (ok (= 256 (log-sink-max-record s)))
        (ok (= +log-index-stride+ (log-sink-index-stride s)))
        (ok (not (log-sink-memory-only-p s)))
        (ok (= 0 (log-sink-last-line s)))
        (ok (uiop:directory-exists-p d) "directory made at once")))
    (ok (signals (make-log-sink dir :segment-size 1000 :max-record 512) 'supervisor-error)
        "segment-size below 512 + 2 × max-record")
    (with-log-sink (s dir :supervisor-id "1-0000abcd" :unit-id "rpc-3" :kind :rpc)
      (ok (equal "1-0000abcd" (log-sink-supervisor-id s)))
      (ok (equal "rpc-3" (log-sink-unit-id s)))
      (ok (eq :rpc (log-sink-kind s))))))

(deftest log-sink-records-header-and-end
  (with-temp-dir (dir)
    (let ((s (make-log-sink dir :supervisor-id "9-00000001" :unit-id "shell-job-1" :kind :shell-job)))
      (write-lines s :stdout '("one" "two"))
      (write-lines s :stderr '("oops"))
      (sink-close s)
      (ok (null (sink-close s)) "close is idempotent")
      (sink-write-octets s :stdout (line-octets "ignored after close"))
      (let ((all (all-records dir)))
        (ok (equal '(:header :output :output :output :end) (mapcar #'log-record-type all)))
        (ok (equal '(1 2 3 4 5) (lines-of all)))
        (ok (equal '(nil :stdout :stdout :stderr nil) (mapcar #'log-record-stream all)))
        (ok (equal '("one" "two" "oops") (texts (of-type :output all))))
        (let ((h (log-record-detail (first all))))
          (ok (= 1 (getf h :format)))
          (ok (equal "9-00000001" (getf h :supervisor-id)))
          (ok (equal "shell-job-1" (getf h :unit-id)))
          (ok (eq :shell-job (getf h :kind)))
          (ok (= 1 (getf h :segment)))
          (ok (= 1 (getf h :first-line)))
          (ok (= 0 (getf h :dropped-records))))
        (let ((e (log-record-detail (car (last all)))))
          (ok (= 5 (getf e :last-line)))
          (ok (= 13 (getf e :bytes)) "4 + 4 + 5 output octets incl. line feeds")))
      (ok (= 1 (length (segment-files dir))))
      (ok (log-closed-p dir))
      (ok (= 5 (log-last-line dir)))
      (ok (= 5 (log-sink-last-line s))))))

(deftest log-sink-empty-close-still-has-segment
  (with-temp-dir (dir)
    (let ((s (make-log-sink dir)))
      (ok (null (segment-files dir)) "no segment before the first record")
      (sink-close s)
      (ok (= 1 (length (segment-files dir))))
      (ok (equal '(:header :end) (mapcar #'log-record-type (all-records dir)))))))

(deftest log-sink-partial-lines-are-continued
  (with-temp-dir (dir)
    (with-log-sink (s dir)
      (sink-write-octets s :stdout (utf8 "ab"))
      (sink-write-octets s :stdout (octets "c" +lf+ "d"))
      (sink-write-octets s :stdout (octets "e" +lf+))
      (let ((out (log-read dir)))
        (ok (equal '("ab" "c" "d" "e") (texts out)) "flushed at the end of every call")
        (ok (equal '(t nil t nil) (mapcar #'log-record-continued-p out)))
        (ok (equal '("abc" "de") (joined-lines out :stdout)))))))

(deftest log-sink-start-end-arguments
  (with-temp-dir (dir)
    (with-log-sink (s dir)
      (sink-write-octets s :stdout (octets "xxhello" +lf+ "yy") :start 2 :end 8)
      (ok (equal '("hello") (texts (log-read dir)))))))

(deftest log-sink-streams-interleave-in-arrival-order
  (with-temp-dir (dir)
    (with-log-sink (s dir)
      (sink-write-octets s :stdout (utf8 "out-a "))
      (sink-write-octets s :stderr (line-octets "err-1"))
      (sink-write-octets s :stdout (line-octets "out-b"))
      (let ((out (log-read dir)))
        (ok (equal '(:stdout :stderr :stdout) (mapcar #'log-record-stream out)))
        (ok (equal '("out-a out-b") (joined-lines out :stdout)) "continuation is per stream")
        (ok (equal '("err-1") (joined-lines out :stderr)))
        (ok (equal '("err-1") (texts (log-read dir :streams '(:stderr)))))))))

(deftest log-sink-long-lines-split
  (with-temp-dir (dir)
    (with-log-sink (s dir :max-record 10 :segment-size 4096)
      (sink-write-octets s :stdout (line-octets (make-string 25 :initial-element #\x)))
      (let ((out (log-read dir)))
        (ok (equal '(10 10 5) (mapcar (lambda (r) (length (log-record-octets r))) out)))
        (ok (equal '(t t nil) (mapcar #'log-record-continued-p out)))
        (ok (equal (list (make-string 25 :initial-element #\x)) (joined-lines out :stdout))))))
  (with-temp-dir (dir)
    (with-log-sink (s dir :max-record 10 :segment-size 4096)
      ;; é is 2 octets: 5 of them fill 10; a split never cuts a character.
      (sink-write-octets s :stdout (line-octets "aéééééé"))
      ;; 13 octets: the first split moves back from 10 to 9 (after the 4th é).
      (let ((out (log-read dir)))
        (ok (equal '(9 4) (mapcar (lambda (r) (length (log-record-octets r))) out)))
        (ok (equal '("aéééé" "éé") (texts out)) "every record is whole UTF-8")
        (ok (equal '(t nil) (mapcar #'log-record-continued-p out)))
        (ok (equal '("aéééééé") (joined-lines out :stdout)))))))

(deftest log-sink-utf8-split-across-writes-is-carried
  (with-temp-dir (dir)
    (with-log-sink (s dir)
      (sink-write-octets s :stdout (octets #xc3))
      (sink-write-octets s :stdout (octets #xa9 +lf+))
      (let ((out (log-read dir)))
        (ok (= 1 (length out)) "the lone lead byte waited for its continuation")
        (ok (string= "é" (log-record-text (first out))))
        (ok (string= (format nil "é~%") (sink-text s)) "the memory view decodes it once")))))

(deftest log-sink-binary-round-trip
  (with-temp-dir (dir)
    (let ((data (random-octets 20000 :seed 11))
          (state (sb-ext:seed-random-state 3)))
      (with-log-sink (s dir :max-record 512 :segment-size 65536 :segments 4)
        (loop with i = 0
              while (< i (length data))
              do (let ((n (min (- (length data) i) (1+ (random 700 state)))))
                   (sink-write-octets s :stdout data :start i :end (+ i n))
                   (incf i n)))
        (sink-close s)
        (let ((records (log-read dir)))
          (ok (equalp data (stream-bytes records :stdout)) "exact bytes back")
          (ok (some (lambda (r) (log-record-continued-p r)) records)))
        (ok (every (lambda (p)
                     (every (lambda (l) (every (lambda (b) (or (= b 9) (<= 32 b 126) (>= b 128)))
                                               (subseq l 0 (1- (length l)))))
                            (physical-lines p)))
                   (segment-files dir))
            "no control bytes but the line feed in the files")))))

(deftest log-sink-head-tail-view
  (with-temp-dir (dir)
    (with-log-sink (s dir :head-size 4 :tail-size 6)
      (sink-write s :stdout "0123456789")
      (sink-write-octets s :stderr (utf8 "abcdefghij"))
      (ok (string= (concatenate 'string "0123" (marker 10) "efghij") (sink-text s)))
      (ok (equal '(20 10) (multiple-value-list (sink-stats s))))
      (ok (equal '("0123456789" "abcdefghij") (texts (log-read dir)))
          "sink-write text goes to the files too"))))

(deftest log-sink-rotation-respects-caps
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 1024 :segments 3 :max-record 128)
      (write-lines s :stdout (numbered-lines "line-" 400 :pad 20))
      (let ((files (segment-files dir)))
        (ok (<= (length files) 3))
        (ok (every (lambda (p) (<= (file-bytes p) 1024)) files) "no segment over its size")
        (ok (<= (files-bytes files) (* 3 1024)))
        (ok (= (length files) (length (index-files dir))) "one index per segment"))
      (let ((infos (log-segments dir)))
        (ok (= (length infos) (length (segment-files dir))))
        (ok (contiguous-p (mapcar #'log-segment-number infos)) "the newest ones, by number")
        (ok (> (log-segment-number (first infos)) 1) "old segments were dropped")
        (ok (loop for (a b) on infos while b
                  always (= (log-segment-first-line b) (1+ (log-segment-last-line a))))
            "line ranges continue across segments")
        (ok (= (file-bytes (log-segment-path (car (last infos))))
               (log-segment-bytes (car (last infos)))))))))

(deftest log-sink-drop-markers-exact
  (with-temp-dir (dir)
    (let ((lines (numbered-lines "L" 300 :pad 30)))
      (with-log-sink (s dir :segment-size 2048 :segments 2 :max-record 128)
        (write-lines s :stdout lines)
        (multiple-value-bind (records gaps) (log-read dir :types t)
          (let* ((drops (of-type :drop records))
                 (kept (of-type :output records))
                 (kept-texts (texts kept)))
            (ok (plusp (length drops)) "segments were dropped")
            (ok (= 1 (length gaps)) "one gap: the dropped prefix")
            (let ((g (first gaps)))
              (ok (= 1 (log-gap-first-line g)))
              (ok (= (1- (log-record-line (first records))) (log-gap-last-line g)))
              (ok (= (log-gap-last-line g) (log-gap-records g)))
              (ok (equal '(:rotated) (log-gap-reasons g)))
              (ok (= (* 37 (- (length lines) (length kept)))
                     (log-gap-bytes g))
                  "every dropped output line was 36 octets + LF"))
            (ok (equal kept-texts (last lines (length kept))) "the newest lines are kept, in order")
            ;; The retained markers describe the newest dropped segments exactly.
            (dolist (d drops)
              (let ((det (log-record-detail d)))
                (ok (eq :rotated (getf det :reason)))
                (ok (= (getf det :records) (1+ (- (getf det :last-line) (getf det :first-line)))))
                (ok (< (getf det :last-line) (log-record-line (first kept))))))
            (let ((newest-drop (car (last drops))))
              (ok (= (1- (log-segment-first-line (first (log-segments dir))))
                     (getf (log-record-detail newest-drop) :last-line))
                  "the newest marker ends right before the oldest retained segment"))))))))
