(in-package #:supervisor-protocol/tests)

;;; H8b reader API over standalone sinks: line ranges across rotations, gaps,
;;; tail, follow with wait, iteration, segment stats, indexes (use, rebuild),
;;; torn tails and corrupt bytes, the Windows open-reader rotation, designators.

(defun fill-sink (sink n &key (prefix "r-") (pad 20) (stream :stdout))
  (let ((lines (numbered-lines prefix n :pad pad)))
    (write-lines sink stream lines)
    lines))

(deftest log-read-across-rotation-is-seamless
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 2048 :segments 50 :max-record 128)
      (let* ((lines (fill-sink s 200))
             (infos (log-segments dir)))
        (ok (> (length infos) 3) "several segments")
        ;; A range from the middle of segment 1 to the middle of segment 3.
        (let* ((a (+ (log-segment-first-line (first infos)) 5))
               (b (- (log-segment-last-line (third infos)) 5)))
          (multiple-value-bind (records gaps next) (log-read dir :start a :end b :types t)
            (ok (null gaps))
            (ok (equal (loop for i from a to b collect i) (lines-of records))
                "every line, once, in order, headers included")
            (ok (= (1+ b) next))))
        (multiple-value-bind (out gaps) (log-read dir)
          (ok (null gaps))
          (ok (equal lines (texts out)) "all output, no header in between")
          (ok (equal (mapcar #'log-segment-number infos)
                     (remove-duplicates (mapcar #'log-record-segment out)))
              "records know their segment")
          (ok (every #'integerp (mapcar #'log-record-offset out))))))))

(deftest log-read-limit-and-paging
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 2048 :segments 50 :max-record 128)
      (let ((lines (fill-sink s 120)) (got '()) (start 1))
        (loop repeat 100
              do (multiple-value-bind (records gaps next) (log-read dir :start start :limit 7)
                   (declare (ignore gaps))
                   (ok (<= (length records) 7))
                   (setf got (append got (texts records)) start next)
                   (when (null records) (return))))
        (ok (equal lines got) "paging with NEXT-LINE sees every line once")))))

(deftest log-read-reports-the-whole-gap
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 1024 :segments 2 :max-record 128)
      (fill-sink s 200)
      (let* ((first-kept (log-segment-first-line (first (log-segments dir))))
             (inside (floor first-kept 2)))
        (multiple-value-bind (records gaps next) (log-read dir :start inside :end (+ first-kept 2)
                                                               :types t)
          (ok (= 1 (length gaps)))
          (ok (= 1 (log-gap-first-line (first gaps))) "the whole gap, not the overlap")
          (ok (= (1- first-kept) (log-gap-last-line (first gaps))))
          (ok (equal (list first-kept (+ 1 first-kept) (+ 2 first-kept)) (lines-of records)))
          (ok (= (+ 3 first-kept) next)))
        (multiple-value-bind (records gaps) (log-read dir :start 1 :end 3)
          (ok (null records))
          (ok (= 1 (length gaps)) "a range entirely inside a gap"))))))

(deftest log-tail-last-n
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 2048 :segments 50 :max-record 128)
      (let ((lines (fill-sink s 100)))
        (fill-sink s 3 :prefix "err-" :stream :stderr)
        (multiple-value-bind (records gaps) (log-tail dir 5)
          (ok (null gaps))
          (ok (equal (append (last lines 2) (numbered-lines "err-" 3 :pad 20)) (texts records))))
        (ok (equal (last lines 4) (texts (log-tail dir 4 :streams '(:stdout)))))
        (ok (= 103 (length (log-tail dir 1000))) "N above the count: everything")))
    (with-temp-dir (dir2)
      (with-log-sink (s dir2 :segment-size 1024 :segments 2 :max-record 128)
        (fill-sink s 200)
        (multiple-value-bind (records gaps) (log-tail dir2 10000)
          (ok (plusp (length records)))
          (ok (= 1 (length gaps)) "the tail reached into the dropped prefix"))))))

(deftest log-follow-waits-for-new-lines
  (with-temp-dir (dir)
    (with-log-sink (s dir)
      (fill-sink s 3)
      (multiple-value-bind (records gaps next ended) (log-follow s)
        (declare (ignore gaps))
        (ok (= 3 (length records)) "what is there, at once")
        (ok (not ended))
        (let ((writer (spawn (lambda () (sleep 0.3) (write-lines s :stdout '("late"))))))
          (multiple-value-bind (secs result) (elapsed (lambda () (multiple-value-list
                                                                  (log-follow s :from next :wait 10))))
            (ok (equal '("late") (texts (first result))))
            (ok (< secs 3) "returned soon after the write, not at the end of WAIT")
            (ok (>= secs 0.2)))
          (bt2:join-thread writer))
        (multiple-value-bind (secs result)
            (elapsed (lambda () (multiple-value-list (log-follow s :from (+ next 1) :wait 0.4))))
          (ok (null (first result)) "nothing new")
          (ok (<= 0.35 secs 3) "waited about WAIT"))
        (let ((closer (spawn (lambda () (sleep 0.2) (sink-close s)))))
          (multiple-value-bind (recs gaps2 next2 ended2) (log-follow s :from (+ next 1) :wait 10)
            (declare (ignore gaps2 next2))
            (ok (null recs))
            (ok ended2 "the end record ends the follow"))
          (bt2:join-thread closer))))))

(deftest log-follow-polls-a-directory
  (with-temp-dir (dir)
    (with-log-sink (s dir)
      (fill-sink s 2)
      (let* ((log (unit-log dir))
             (next (nth-value 2 (log-follow log)))
             (writer (spawn (lambda () (sleep 0.3) (write-lines s :stdout '("seen-by-poll"))))))
        (multiple-value-bind (secs result)
            (elapsed (lambda () (multiple-value-list (log-follow log :from next :wait 10))))
          (ok (equal '("seen-by-poll") (texts (first result))))
          (ok (< secs 3)))
        (bt2:join-thread writer)))))

(deftest log-map-records-in-order
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 2048 :segments 50 :max-record 128)
      (let ((lines (fill-sink s 150)) (seen '()))
        (fill-sink s 2 :prefix "e-" :stream :stderr)
        (ok (null (map-log-records (lambda (r) (push (log-record-text r) seen)) dir
                                   :streams '(:stdout))))
        (ok (equal lines (reverse seen)))
        (let ((types '()))
          (map-log-records (lambda (r) (push (log-record-type r) types)) dir :types '(:header))
          (ok (= (length (log-segments dir)) (length types)) "one header per segment"))))))

(deftest log-segment-stats
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 2048 :segments 50 :max-record 128)
      (let ((lines (fill-sink s 100)))
        (sink-close s)
        (let ((infos (log-segments dir)))
          (ok (equal (loop for i from 1 to (length infos) collect i)
                     (mapcar #'log-segment-number infos)))
          (dolist (i infos)
            (ok (equal (seg-path dir (log-segment-number i)) (log-segment-path i)))
            (ok (equal (idx-path dir (log-segment-number i)) (log-segment-index-path i)))
            (ok (= (file-bytes (log-segment-path i)) (log-segment-bytes i)))
            (ok (= (log-segment-records i)
                   (1+ (- (log-segment-last-line i) (log-segment-first-line i)))))
            (ok (<= (log-segment-first-time i) (log-segment-last-time i)))
            (ok (not (log-segment-torn-p i))))
          (ok (= (* 28 (length lines)) (reduce #'+ infos :key #'log-segment-output-bytes))
              "27 octets per line + LF")
          (ok (= (log-last-line dir) (log-segment-last-line (car (last infos))))))))))

(deftest log-index-entries-point-at-records
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 65536 :segments 5 :max-record 128 :index-stride 16)
      (fill-sink s 500)
      (sink-close s)
      (let* ((idx (read-file-octets (idx-path dir 1)))
             (seg (read-file-octets (seg-path dir 1))))
        (ok (equalp (utf8 "SPLX") (subseq idx 0 4)))
        (ok (= 16 (logior (aref idx 4) (ash (aref idx 5) 8))) "stride, little-endian")
        (ok (= 1 (aref idx 8)) "first line")
        (ok (zerop (mod (- (length idx) 16) 8)))
        (loop for k from 0 below (floor (- (length idx) 16) 8)
              for off = (loop for j from 7 downto 0
                              sum (ash (aref idx (+ 16 (* 8 k) j)) (* 8 j)))
              do (ok (= (1+ (* 16 k)) (first-field (subseq seg off (min (length seg) (+ off 24)))))
                     (format nil "entry ~D → line ~D" k (1+ (* 16 k)))))))))

(deftest log-index-missing-or-corrupt-is-rebuilt
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 8192 :segments 50 :max-record 128)
      (let ((lines (fill-sink s 600)))
        (sink-close s)
        (ok (>= (length (segment-files dir)) 4) "fixture: at least 4 segments")
        (let ((good (read-file-octets (idx-path dir 2)))
              (target (nth 250 lines)))
          (delete-file (idx-path dir 2))
          (write-file-octets (idx-path dir 3) (random-octets 100 :seed 5))
          (ok (equal lines (texts (log-read dir))) "reads are right without / with a bad index")
          (ok (probe-file (idx-path dir 2)) "a missing index is rewritten")
          (ok (equalp good (read-file-octets (idx-path dir 2))) "identical to the original")
          (ok (equalp (utf8 "SPLX") (subseq (read-file-octets (idx-path dir 3)) 0 4))
              "a corrupt one too")
          (let ((r (find target (log-read dir) :key #'log-record-text :test #'string=)))
            (ok (equal (list target)
                       (texts (log-read dir :start (log-record-line r) :end (log-record-line r))))
                "a single-line read through the rebuilt index")))
        (delete-file (idx-path dir 1))
        (delete-file (idx-path dir 4))
        (ok (= (length (log-segments dir)) (rebuild-log-index dir)) "explicit: every segment")
        (ok (probe-file (idx-path dir 1)))
        (ok (= 1 (rebuild-log-index dir :segment 4)))))))

(deftest log-torn-tail-is-skipped
  (with-temp-dir (dir)
    (let ((s (make-log-sink dir :segment-size 8192 :segments 50 :max-record 128))
          (lines (numbered-lines "t-" 50)))
      (write-lines s :stdout lines)
      ;; No close: as after a SIGKILL. Then a torn record, as a crash mid-write.
      (let ((newest (car (last (segment-files dir)))))
        (append-file-octets newest (utf8 "52 1700000000000 99 ot. torn-li"))
        (ok (equal lines (texts (log-read dir))) "everything before the torn line")
        (ok (log-segment-torn-p (car (last (log-segments dir)))))
        (ok (not (log-closed-p dir)))
        (ok (= 51 (log-last-line dir)) "header + 50 lines"))
      (ignore-errors (sink-close s)))))

(deftest log-corrupt-bytes-are-a-gap
  (with-temp-dir (dir)
    (with-log-sink (s dir :segment-size 8192 :segments 50 :max-record 128)
      (let ((lines (numbered-lines "c-" 10)))
        (write-lines s :stdout lines)
        (sink-close s)
        ;; Overwrite one payload byte of line 6 (output line "c-00005") in place.
        (let* ((path (seg-path dir 1))
               (v (read-file-octets path))
               (pl (physical-lines path))
               (off (reduce #'+ (subseq pl 0 5) :key #'length)))
          (incf (aref v (+ off 28)))
          (write-file-octets path v))
        (multiple-value-bind (records gaps) (log-read dir)
          (ok (equal (remove (nth 4 lines) lines :test #'string=) (texts records))
              "only the damaged record is lost")
          (ok (= 1 (length gaps)))
          (ok (= 6 (log-gap-first-line (first gaps))))
          (ok (= 6 (log-gap-last-line (first gaps))))
          (ok (equal '(:corrupt) (log-gap-reasons (first gaps))))
          (ok (null (log-gap-bytes (first gaps)))))))))

(deftest log-rotation-with-an-open-reader
  ;; Windows: a held segment cannot be deleted (no FILE_SHARE_DELETE); the drop is
  ;; logical at once and the delete deferred. Unix: deleted at once; the reader
  ;; keeps reading the old file.
  (with-temp-dir (dir)
    (let ((s (make-log-sink dir :segment-size 1024 :segments 2 :max-record 128)))
      (unwind-protect
           (progn
             (loop until (probe-file (seg-path dir 2)) do (fill-sink s 1))
             (let ((held (open (seg-path dir 1) :element-type '(unsigned-byte 8))))
               (unwind-protect
                    (let ((first-byte (read-byte held)))
                      (ok (= (char-code #\1) first-byte))
                      (ok (no-error-p (lambda () (fill-sink s 60))) "rotation past the cap: no error")
                      (ok (not (member 1 (mapcar #'log-segment-number (log-segments dir))))
                          "segment 1 is no longer listed")
                      (multiple-value-bind (records gaps) (log-read dir :start 1 :end 3 :types t)
                        (ok (null records))
                        (ok (= 1 (log-gap-first-line (first gaps))) "it reads as a gap"))
                      (if (windows-p)
                          (ok t "Windows: the delete may wait for the reader")
                          (progn
                            (ok (null (probe-file (seg-path dir 1))) "Unix: deleted at once")
                            (ok (integerp (read-byte held nil nil)) "the open reader still reads"))))
                 (close held)))
             (fill-sink s 60)
             (sink-close s)
             (ok (null (probe-file (seg-path dir 1))) "gone once the reader closed")
             (ok (null (probe-file (idx-path dir 1)))))
        (ignore-errors (sink-close s))))))

(deftest log-designators-and-directories
  (with-temp-dir (dir)
    (let* ((d1 (unit-log-pathname dir "11-aaaaaaaa" "shell-job-1"))
           (d2 (unit-log-pathname dir "11-aaaaaaaa" "rpc-1"))
           (d3 (unit-log-pathname dir "22-bbbbbbbb" "shell-job-1")))
      (ok (equal (merge-pathnames "units/11-aaaaaaaa--shell-job-1/" dir) d1))
      (dolist (d (list d1 d2 d3))
        (with-log-sink (s d) (write-lines s :stdout (list (namestring d)))))
      (let ((all (find-unit-logs dir)))
        (ok (= 3 (length all)))
        (ok (every (lambda (l) (typep l 'unit-log)) all))
        (ok (equal '("11-aaaaaaaa" "11-aaaaaaaa" "22-bbbbbbbb")
                   (mapcar #'unit-log-supervisor-id all)))
        (ok (equal '("rpc-1" "shell-job-1" "shell-job-1") (mapcar #'unit-log-unit-id all))))
      (ok (= 2 (length (find-unit-logs dir :supervisor-id "11-aaaaaaaa"))))
      (ok (= 2 (length (find-unit-logs dir :unit-id "shell-job-1"))))
      (ok (null (find-unit-logs (merge-pathnames "nowhere/" dir))))
      (let ((log (unit-log d1)))
        (ok (eq log (unit-log log)))
        (ok (equal (texts (log-read log)) (texts (log-read (namestring d1)))) "namestring designator")
        (ok (eq t (delete-unit-log log)))
        (ok (not (uiop:directory-exists-p d1)))
        (ok (= 2 (length (find-unit-logs dir)))))
      (ok (signals (unit-log (merge-pathnames "units/none/" dir)) 'log-not-found)))))
