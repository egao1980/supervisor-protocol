(in-package #:supervisor-protocol/tests)

;;; Restart policies: :never (jobs), :on-failure + backoff (servers).

(deftest killed-server-restarts-exactly-once-with-backoff
  (with-supervisor (sup)
    (let* ((c (make-collector sup))
           (srv (start-unit sup :rpc :command (echo-server-argv)
                                     :max-restarts 1 :backoff '(0.4 2 5)))
           (id (unit-id srv))
           (pid1 (unit-pid srv)))
      (os-kill pid1)
      (ok (wait-until (lambda () (and (eq :running (unit-state srv))
                                      (= 1 (unit-restart-count srv))))
                      :timeout 20)
          "restarted")
      (let ((pid2 (unit-pid srv)))
        (ok (and pid2 (/= pid1 pid2)) "a new process")
        (ok (pid-alive-p pid2))
        (ok (string= id (unit-id srv)) "same unit, same id")
        (ok (wait-until (lambda () (progn (send-unit-input srv (format nil "again~%"))
                                          (search "again" (unit-output srv))))
                        :timeout 20)
            "the new process is wired to the same unit")
        (os-kill pid2))
      (ok (eq :failed (wait-unit srv :timeout 20)) "max-restarts 1: the second death is final")
      (ok (= 1 (unit-restart-count srv)))
      (ok (unit-finished-p srv))
      (let* ((events (unit-events (wait-collected c (lambda (es) (<= 7 (length (unit-events es id))))) id))
             (shape (mapcar (lambda (e) (list (event-type e) (event-from e) (event-to e))) events)))
        (ok (equal '((:state nil :starting)
                     (:state :starting :running)
                     (:state :running :failed)
                     (:restart-scheduled :failed :starting)
                     (:state :failed :starting)
                     (:state :starting :running)
                     (:state :running :failed))
                   shape)
            "every transition, in order, nothing after the final failure")
        (let ((sched (find :restart-scheduled events :key #'event-type))
              (failed (third events))
              (relaunch (fifth events)))
          (ok (equal 1 (getf (event-detail sched) :attempt)))
          (ok (< (abs (- 0.4 (getf (event-detail sched) :delay))) 1d-9))
          (ok (>= (- (event-monotonic relaunch) (event-monotonic failed)) 0.39) "waited the backoff"))))))

(deftest never-policy-does-not-restart
  (with-supervisor (sup)
    (let* ((c (make-collector sup))
           (u (start-unit sup :shell-job :command (exit-argv 3))))
      (ok (eq :failed (wait-unit u :timeout 20)))
      (sleep 0.5)
      (ok (= 0 (unit-restart-count u)))
      (ok (notany (lambda (e) (eq :restart-scheduled (event-type e)))
                  (unit-events (collected c) (unit-id u)))))))

(deftest on-failure-ignores-success-and-stops
  (with-supervisor (sup)
    (let ((ok0 (start-unit sup :rpc :command (exit-argv 0) :backoff '(0.05 1 0.05)))
          (stopped (start-unit sup :rpc :command (sleeper-argv 60) :backoff '(0.05 1 0.05))))
      (ok (eq :exited (wait-unit ok0 :timeout 20)) "exit 0 is not a failure")
      (ok (eq :killed (stop-unit stopped :grace 2)) "a stop is not a failure")
      (sleep 0.5)
      (ok (= 0 (unit-restart-count ok0)))
      (ok (= 0 (unit-restart-count stopped)))
      (ok (eq :killed (unit-state stopped))))))

(deftest thread-unit-restarts-up-to-max
  (with-supervisor (sup)
    (let* ((runs 0)
           (u (start-unit sup :subagent :restart :on-failure :max-restarts 2 :backoff '(0.05 1 1)
                                        :function (lambda (u) (declare (ignore u))
                                                    (incf runs) (error "boom")))))
      (ok (eq :failed (wait-unit u :timeout 10)))
      (ok (= 3 runs) "first run + 2 restarts")
      (ok (= 2 (unit-restart-count u))))))

(deftest stop-cancels-a-pending-restart
  (with-supervisor (sup)
    (let ((u (start-unit sup :rpc :command (exit-argv 4) :backoff '(5 1 5))))
      (ok (wait-until (lambda () (eq :failed (unit-state u))) :timeout 20))
      (ok (not (unit-finished-p u)) "restart pending")
      (ok (eq :failed (stop-unit u)) "already ended: keeps its state")
      (ok (unit-finished-p u) "no restart pending any more")
      (sleep 0.3)
      (ok (= 0 (unit-restart-count u))))))

;;; An executor whose first launch fails at once (exit 1) and whose later
;;; launches cannot start: each restart's launch failure is an attempt.
(defclass flaky-executor (stubborn-executor)
  ((launches :initform 0 :accessor flaky-launches)))

(defmethod executor-launch ((e flaky-executor) unit)
  (if (= 1 (incf (flaky-launches e)))
      (make-stubborn-handle :alive nil)
      (error 'unit-start-error :kind (unit-kind unit) :cause "gone")))

(defmethod executor-wait ((e flaky-executor) unit handle &key timeout)
  (declare (ignore unit handle timeout))
  (values t 1 nil nil))

(deftest relaunch-failure-counts-as-an-attempt
  (with-supervisor (sup)
    (let* ((c (make-collector sup))
           (e (make-instance 'flaky-executor))
           (u (start-unit sup :rpc :executor e :max-restarts 2 :backoff '(0.05 1 0.05))))
      (ok (eq :failed (wait-unit u :timeout 10)))
      (ok (= 3 (flaky-launches e)))
      (ok (= 2 (unit-restart-count u)))
      (ok (member '(:state :starting :failed)
                  (transitions (wait-collected c (lambda (es) (<= 8 (length (unit-events es (unit-id u))))))
                               (unit-id u))
                  :test #'equal)
          "a failed relaunch goes :starting → :failed"))))
