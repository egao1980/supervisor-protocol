(in-package #:supervisor-protocol/tests)

;;; H8b through the supervisor: default log sinks and their settings, process
;;; output (text and binary) in files, a chatty unit under its cap, thread-unit
;;; streams, the total cap's eviction order, logs outliving units and restarts.

(defmacro with-logged-supervisor ((var dir &rest keys) &body body)
  `(with-temp-dir (,dir)
     (with-supervisor (,var :state-directory ,dir ,@keys)
       ,@body)))

(deftest log-default-sinks-and-settings
  (with-logged-supervisor (sup dir :log-segment-size 4096 :log-segments 3)
    (ok (supervisor-log-p sup))
    (ok (= 4096 (supervisor-log-segment-size sup)))
    (ok (= 3 (supervisor-log-segments sup)))
    (ok (= +default-log-total-cap+ (supervisor-log-total-cap sup)))
    (ok (= +default-log-max-record+ (supervisor-log-max-record sup)))
    (let ((a (start-unit sup :subagent :function (lambda (u) (declare (ignore u)) :ok)))
          (b (start-unit sup :subagent :function (lambda (u) (declare (ignore u)) :ok)
                                       :log-segment-size 8192 :log-segments 2))
          (c (start-unit sup :subagent :function (lambda (u) (declare (ignore u)) :ok) :log nil)))
      (ok (typep (unit-output-sink a) 'log-sink))
      (ok (equal (unit-log-dir sup a) (log-sink-directory (unit-output-sink a))))
      (ok (equal '(:enabled t :segment-size 4096 :segments 3) (unit-log-settings a)))
      (ok (= 4096 (log-sink-segment-size (unit-output-sink a))))
      (ok (= 8192 (log-sink-segment-size (unit-output-sink b))) "per start-unit override")
      (ok (= 2 (log-sink-segments (unit-output-sink b))))
      (ok (equal (unit-id b) (log-sink-unit-id (unit-output-sink b))))
      (ok (eq b (log-sink-unit (unit-output-sink b))))
      (ok (not (getf (unit-log-settings c) :enabled)))
      (ok (typep (unit-output-sink c) 'head-tail-buffer))
      (ok (not (typep (unit-output-sink c) 'log-sink)) ":log nil → memory only")
      (ok (signals (unit-log c) 'log-not-found))
      (ok (typep (unit-log a) 'unit-log))))
  (with-temp-dir (dir)
    (with-supervisor (sup :state-directory dir :log nil)
      (let ((u (start-unit sup :subagent :function (lambda (u) (declare (ignore u)) :ok))))
        (ok (not (typep (unit-output-sink u) 'log-sink)) "make-supervisor :log nil")
        (ok (null (find-unit-logs dir))))))
  (with-supervisor (sup)
    (let ((u (start-unit sup :subagent :function (lambda (u) (declare (ignore u)) :ok))))
      (ok (not (typep (unit-output-sink u) 'log-sink)) "no state directory → 0.1.0 behaviour"))))

(deftest log-process-stdout-and-stderr
  (with-logged-supervisor (sup dir)
    (let ((u (start-unit sup :shell-job
                         :command (lisp-argv "(progn (write-line \"out-1\") (finish-output) (sleep 0.1) (write-line \"err-1\" *error-output*) (finish-output *error-output*) (sleep 0.1) (write-line \"out-2\") (finish-output))"))))
      (ok (eq :exited (wait-unit u :timeout 60)))
      (let ((records (log-read u)))
        (ok (equal '("out-1" "out-2") (joined-lines records :stdout)))
        (ok (equal '("err-1") (joined-lines records :stderr)))
        (ok (equal '("out-1" "err-1" "out-2") (texts records)) "arrival order"))
      (ok (log-closed-p u) "finished → end record")
      (ok (search "err-1" (unit-output u)) "the memory view is fed from the same pump")
      (ok (equal (list (unit-log-dir sup u))
                 (mapcar #'unit-log-directory (find-unit-logs dir :unit-id (unit-id u))))))))

(deftest log-process-binary-output-round-trips
  (with-logged-supervisor (sup dir)
    (let* ((data (octets (loop for i below 256 collect i) (loop for i from 255 downto 0 collect i)
                         (random-octets 3000 :seed 9)))
           (u (start-unit sup :shell-job
                          :command (lisp-argv
                                    (format nil "(progn (write-sequence (coerce '~A '(vector (unsigned-byte 8))) sb-sys:*stdout*) (finish-output sb-sys:*stdout*))"
                                            (lit (coerce data 'list)))))))
      (ok (eq :exited (wait-unit u :timeout 60)))
      (ok (equalp data (stream-bytes (log-read u) :stdout)) "every byte, unchanged"))))

(deftest log-chatty-unit-stays-under-its-cap
  ;; 100 MiB of output with the default 1 MiB × 5 per unit.
  (with-logged-supervisor (sup dir)
    (let* ((n 102400)
           (u (start-unit sup :shell-job
                          :command (lisp-argv
                                    (format nil "(let ((l (make-string 1023 :initial-element #\\x))) (dotimes (i ~D) (write-line l)) (format t \"last-line-~~D~~%\" ~D) (finish-output))" n n))))
           (written (+ (* n 1024) (length "last-line-102400") 1)))
      (ok (eq :exited (wait-unit u :timeout 150)))
      (let* ((ldir (unit-log-dir sup u))
             (segs (segment-files ldir)))
        (ok (<= (length segs) 5))
        (ok (every (lambda (p) (<= (file-bytes p) +default-log-segment-size+)) segs))
        (ok (<= (files-bytes segs) (* 5 +default-log-segment-size+)) "under 5 MiB")
        (ok (<= (files-bytes (index-files ldir)) (floor (files-bytes segs) 100)) "indexes are small")
        (multiple-value-bind (records gaps) (log-read u)
          (ok (string= "last-line-102400" (log-record-text (car (last records)))))
          (ok (= 1 (length gaps)))
          (ok (= written (+ (gap-bytes-total gaps)
                            (length (stream-bytes records :stdout))))
              "dropped + retained bytes = everything the unit wrote")
          (ok (equal '(:rotated) (log-gap-reasons (first gaps))))))
      (ok (= written (sink-stats (unit-output-sink u))) "every character counted in memory")
      (ok (<= (length (unit-output u)) (+ +default-head-size+ +default-tail-size+ 64))
          "memory holds only the head + tail"))))

(deftest log-thread-unit-streams-are-captured
  (with-logged-supervisor (sup dir)
    (let ((u (start-unit sup :subagent
                         :function (lambda (u)
                                     (declare (ignore u))
                                     (format t "hello ~A~%" "world")
                                     (write-string "partial" *error-output*)
                                     (finish-output *error-output*)
                                     (princ "no-newline-at-end")
                                     :done))))
      (ok (eq :exited (wait-unit u :timeout 10)))
      (ok (typep *standard-output* '(not sink-output-stream)) "only the unit's thread is rebound")
      (let ((records (log-read u)))
        (ok (equal '("hello world" "partial" "no-newline-at-end") (texts records)))
        (ok (equal '(:stdout :stderr :stdout) (mapcar #'log-record-stream records)))
        (ok (equal '(nil t t) (mapcar #'log-record-continued-p records)))
        (ok (log-closed-p u))
        (ok (< (log-record-line (car (last records))) (log-last-line u)) "end record after the flush"))
      (ok (search "no-newline-at-end" (unit-output u))))))

(deftest log-thread-stream-flush-rules
  (with-temp-dir (dir)
    (with-log-sink (s dir)
      (let ((out (make-sink-output-stream s :stdout)))
        (ok (typep out 'sink-output-stream))
        (ok (output-stream-p out))
        (ok (eq s (sink-output-stream-sink out)))
        (ok (eq :stdout (sink-output-stream-name out)))
        (write-string "buffered" out)
        (ok (null (log-read dir)) "no newline, no flush yet")
        (terpri out)
        (ok (equal '("buffered") (texts (log-read dir))) "a newline flushes")
        (write-string (make-string 5000 :initial-element #\y) out)
        (ok (>= (length (log-read dir)) 2) "4096 characters flush")
        (finish-output out)
        (ok (equal (list "buffered" (make-string 5000 :initial-element #\y))
                   (joined-lines (log-read dir) :stdout)))
        (ok (signals (make-sink-output-stream s :stdin) 'type-error))))))

(deftest log-total-cap-evicts-oldest-finished-first
  ;; Lines of 100 octets (+ LF); each of A and B writes about 4 KB, the cap is
  ;; 6000: A alone fits, A + B does not, A's stub + B does. C (running) then
  ;; writes about 12 KB.
  (with-logged-supervisor (sup dir :log-segment-size 2048 :log-segments 20 :log-max-record 256
                                   :log-total-cap 6000)
    (labels ((writer (tag n &optional then)
               (start-unit sup :subagent :function (writer-body (numbered-lines tag n :pad 93)
                                                                :then then)))
             (output-lines (u) (length (log-read u)))
             (gap-reasons (u) (reduce #'append (nth-value 1 (log-read u)) :key #'log-gap-reasons))
             (on-disk (u) (let ((d (unit-log-dir sup u)))
                            (+ (files-bytes (segment-files d)) (files-bytes (index-files d))))))
      (let ((a (writer "a-" 26)))
        (ok (eq :exited (wait-unit a :timeout 10)))
        (ok (= 26 (output-lines a)) "alone: under the cap")
        (ok (null (gap-reasons a)))
        (let ((b (writer "b-" 26)))
          (ok (eq :exited (wait-unit b :timeout 10)))
          (ok (wait-until (lambda () (<= (supervisor-log-usage sup) 6000)) :timeout 5))
          (ok (member :total-cap (gap-reasons a)) "a, finished first, lost segments")
          (ok (= 26 (output-lines b)) "b lost nothing while a had segments to give")
          (ok (null (gap-reasons b)))
          (let* ((release nil)
                 (c (writer "c-" 120 (lambda (u)
                                       (loop until (or release (unit-stop-requested-p u))
                                             do (sleep 0.01)))))
                 (last-c (format nil "c-00120~A" (make-string 93 :initial-element #\x))))
            (ok (wait-until (lambda ()
                              (let ((r (log-tail c 1)))
                                (and r (string= last-c (log-record-text (first r))))))
                            :timeout 10))
            (ok (wait-until (lambda () (<= (supervisor-log-usage sup) 6000)) :timeout 5))
            (ok (member :total-cap (gap-reasons c)) "the running unit lost its oldest segments")
            (ok (= 0 (output-lines a)) "… only after a (finished) had nothing left")
            (ok (= 0 (output-lines b)) "… and b (finished) had nothing left")
            (ok (eq :running (unit-state c)))
            (let ((newest (car (last (log-segments c)))))
              (ok (probe-file (log-segment-path newest)) "c's newest segment is never evicted")
              (ok (<= (log-segment-first-line newest) (log-record-line (first (log-tail c 1))))))
            (ok (log-closed-p a) "a stub keeps the end record")
            (ok (= 1 (length (segment-files (unit-log-dir sup a)))) "a stub segment is left")
            (ok (= (* 26 101) (gap-bytes-total (nth-value 1 (log-read a))))
                "the stub's gaps account for every byte a wrote")
            (ok (= (supervisor-log-usage sup) (+ (on-disk a) (on-disk b) (on-disk c)))
                "usage = the bytes of segment and index files")
            (setf release t)
            (ok (eq :exited (wait-unit c :timeout 10)))))))))

(deftest log-restart-continues-one-log
  (with-logged-supervisor (sup dir)
    (let ((u (start-unit sup :subagent :restart :on-failure :max-restarts 1 :backoff '(0.05 1 0.05)
                                       :function (lambda (u)
                                                   (format t "attempt ~D~%" (unit-restart-count u))
                                                   (finish-output)
                                                   (error "boom")))))
      (ok (eq :failed (wait-unit u :timeout 10)))
      (let ((records (log-read u)))
        (ok (equal '("attempt 0" "attempt 1") (texts records)) "both launches, one log")
        (ok (= 1 (length (find-unit-logs dir :unit-id (unit-id u)))))))))

(deftest log-outlives-eviction-and-shutdown
  (with-temp-dir (dir)
    (let ((sup (make-supervisor :exit-hook nil :state-directory dir :kind-caps '(:subagent 1)))
          (a nil) (sid nil))
      (unwind-protect
           (progn
             (setf sid (supervisor-id sup)
                   a (start-unit sup :subagent :function (writer-body '("from-a"))))
             (ok (eq :exited (wait-unit a :timeout 10)))
             (start-unit sup :subagent :function (writer-body '("from-b")))
             (ok (null (find-unit sup (unit-id a))) "a was evicted from the registry")
             (ok (equal '("from-a") (texts (log-read a))) "its log is still there"))
        (%quiet-shutdown sup))
      (let ((logs (find-unit-logs dir :supervisor-id sid)))
        (ok (= 2 (length logs)) "shutdown keeps the logs")
        (ok (equal '("from-a") (texts (log-read (first logs)))))
        (ok (every #'log-closed-p logs))))))

(deftest log-follow-a-live-process-unit
  (with-logged-supervisor (sup dir)
    (let ((srv (start-unit sup :rpc :command (echo-server-argv))))
      (let ((next (nth-value 2 (log-follow srv))))
        (send-unit-input srv (format nil "ping-h8b~%"))
        (multiple-value-bind (secs result)
            (elapsed (lambda () (multiple-value-list (log-follow srv :from next :wait 20))))
          (ok (equal '("ping-h8b") (texts (first result))))
          (ok (< secs 15))
          (ok (not (fourth result)) "not ended while running")))
      (stop-unit srv :grace 1)
      (ok (log-closed-p srv)))))
